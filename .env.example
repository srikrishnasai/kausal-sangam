# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kausal_sangam?schema=public"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Email (optional) ---
# Leave RESEND_API_KEY unset and emails are printed to the server console
# instead of sent. That is the intended default for local work: every seeded
# account uses an @example.com address, which cannot receive mail.
# Set BOTH of these to send for real.
# RESEND_API_KEY=""
# EMAIL_FROM="Kausal Sangam <hello@your-verified-domain.com>"

# Absolute base for links inside emails. Falls back to AUTH_URL, then localhost.
APP_URL="http://localhost:3000"
